{% extends 'admin.html.twig' %}

{% block admin %}
    <div class="d-flex justify-content-between align-items-center">
        <h2 class="h1">Médias</h2>
        <a href="{{ path('admin_media_add') }}" class="btn btn-primary">Ajouter</a>
    </div>
    {% if medias is empty %}
        <p>Aucun média disponible.</p>
    {% else %}
        <table class="table">
            <thead>
                <tr>
                    <th>Image</th>
                    <th>Titre</th>
                    {% if is_granted('ROLE_ADMIN') %}
                        <th>Artiste</th>
                        <th>Album</th>
                    {% endif %}
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for media in medias %}
                <tr>
                    <td><img src="{{ asset(media.path) }}" width="75" alt=""></td>
                    <td>{{ media.title }}</td>
                    {% if is_granted('ROLE_ADMIN') %}
                        <td>{{ media.user.name ?? '' }}</td>
                        <td>{{ media.album.name ?? '' }}</td>
                    {% endif %}
                    <td>
                        <form action="{{ path('admin_media_delete', {id: media.id}) }}" method="post" onsubmit="return confirm('Voulez-vous vraiment supprimer ce média ?');" class="d-inline">
                            <input type="hidden" name="_method" value="delete">
                            <input type="hidden" name="page" value="{{ app.request.query.get('page', 1) }}">
                            <button type="submit" class="btn btn-danger">Supprimer</button>
                        </form>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>

        {% include 'admin/_paging.html.twig' with {
            pathName: 'admin_media_index',
            page: page,
            totalPages: totalPages
        } %}
    {% endif %}
{% endblock %}