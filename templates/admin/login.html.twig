{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
    <div class="container">
        <div class="row min-vh-100 align-items-center justify-content-center">
            <main class="col-md-6 col-lg-4">
                <div class="text-center">
                    <img src="{{ asset('images/name.png') }}" alt="Ina Zaoui" class="pb-4 mb-4">
                </div>
                <h1 class="h2 my-4">Connexion</h1>
                {% if app.user %}
                    <p>Vous êtes connecté(e) en tant que {{ app.user.name }}.</p>
                    <a href="{{ logout_path() }}" class="btn btn-primary">Se déconnecter</a>
                {% else %}
                    <form method="post">
                        {% if error %}
                            <div class="alert alert-danger" role="alert">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                        {% endif %}
                        <div class="mb-3">
                            <label for="username" class="form-label">Adresse email</label>
                            <input type="email" value="{{ last_username }}" name="_username" id="username" class="form-control" autocomplete="email" required autofocus>
                        </div>
                        <div class="mb-3">
                            <label for="password" class="form-label">Mot de passe</label>
                            <input type="password" name="_password" id="password" class="form-control" autocomplete="current-password" required>
                            <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">
                        </div>
                        <button type="submit" class="btn btn-primary">Se connecter</button>
                    </form>
                {% endif %}
            </main>
            <nav class="col-md-9 mx-sm-auto col-lg-10 p-4 text-center">
                <a href="{{ path('home') }}" class="btn btn-primary">Retour</a>
            </nav>
        </div>
    </div>
{% endblock %}