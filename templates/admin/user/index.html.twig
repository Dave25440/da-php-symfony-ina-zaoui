{% extends 'admin.html.twig' %}

{% block admin %}
    <div class="d-flex justify-content-between align-items-center">
        <h2 class="h1">Invités</h2>
        <a href="{{ path('admin_user_add') }}" class="btn btn-primary">Ajouter</a>
    </div>
    {% if users is empty %}
        <p>Aucun invité disponible.</p>
    {% else %}
        <table class="table">
            <thead>
                <tr>
                    <th>Nom</th>
                    <th>Adresse email</th>
                    <th>Statut</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for user in users %}
                <tr>
                    <td>{{ user.name }}</td>
                    <td>{{ user.email }}</td>
                    <td>
                        {% if 'ROLE_GUEST' in user.roles %}
                            Actif·ve
                        {% else %}
                            Bloqué·e
                        {% endif %}
                    </td>
                    <td>
                        {% if 'ROLE_GUEST' in user.roles %}
                            <form action="{{ path('admin_user_guest_disable', {id: user.id}) }}" method="post" class="d-inline">
                                <input type="hidden" name="page" value="{{ app.request.query.get('page', 1) }}">
                                <button type="submit" class="btn btn-warning">Bloquer l'accès</button>
                            </form>
                        {% else %}
                            <form action="{{ path('admin_user_guest_enable', {id: user.id}) }}" method="post" class="d-inline">
                                <input type="hidden" name="page" value="{{ app.request.query.get('page', 1) }}">
                                <button type="submit" class="btn btn-success">Activer l'accès</button>
                            </form>
                        {% endif %}
                        <form action="{{ path('admin_user_delete', {id: user.id}) }}" method="post" onsubmit="return confirm('Voulez-vous vraiment supprimer cet·te invité·e ?');" class="d-inline">
                            <input type="hidden" name="_method" value="delete">
                            <input type="hidden" name="page" value="{{ app.request.query.get('page', 1) }}">
                            <button type="submit" class="btn btn-danger">Supprimer</button>
                        </form>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>

        {% include 'admin/_paging.html.twig' with {
            pathName: 'admin_user_index',
            page: page,
            totalPages: totalPages
        } %}
    {% endif %}
{% endblock %}