{% extends 'front.html.twig' %}

{% block title %}{{ guest.name }}{% endblock %}

{% block front %}
    <div class="row">
        <div class="col-12">
            <h1 class="mb-4">{{ block('title') }}</h1>
            <p class="mb-5 w-100">{{ guest.description }}</p>
            <div class="row">
                {% for media in guest.medias %}
                    <div class="col-4 media mb-4">
                        <img class="w-100" src="{{ asset(media.path) }}" alt="{{ media.title }}">
                    </div>
                {% else %}
                    <p>Aucun média disponible.</p>
                {% endfor %}
            </div>
        </div>
    </div>
{% endblock %}